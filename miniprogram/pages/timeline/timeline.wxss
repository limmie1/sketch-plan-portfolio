.tl-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0 12rpx;
}
.tl-date {
  font-family: var(--display);
  font-size: 40rpx;
}
.tl-nav { display: flex; }
.tl-sub {
  font-size: 24rpx;
  color: var(--text-3);
  margin: 4rpx 0 8rpx;
}

.chips { display: flex; gap: 14rpx; margin: 8rpx 0 12rpx; }
.chip {
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 99rpx;
  border: 1rpx solid var(--line);
  color: var(--text-2);
  font-size: 24rpx;
  display: flex;
  align-items: center;
}
.theme-ink .chip { border: 2rpx solid var(--line); border-radius: 12rpx 8rpx 12rpx 6rpx; }
.chip.on {
  color: var(--accent);
  border-color: var(--accent);
  box-shadow: 0 0 0 1rpx var(--accent) inset;
}

.tl-scroll {
  height: 62vh;
  margin-top: 8rpx;
}
.tl-body {
  position: relative;
  padding-left: 92rpx;
}
.tl-hour {
  position: absolute;
  left: 0;
  right: 0;
  height: 100rpx;
}
.tl-h {
  position: absolute;
  left: 0;
  top: -14rpx;
  width: 76rpx;
  font-size: 22rpx;
  color: var(--text-3);
  font-variant-numeric: tabular-nums;
}
.tl-rule {
  position: absolute;
  left: 88rpx;
  right: 0;
  top: 0;
  height: 1rpx;
  background: var(--line-2);
}

.tl-now {
  position: absolute;
  left: 88rpx;
  right: 0;
  height: 2rpx;
  background: var(--accent);
  z-index: 3;
}
.tl-now::before {
  content: '';
  position: absolute;
  left: -6rpx;
  top: -5rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--accent);
}

.tl-block {
  position: absolute;
  left: 96rpx;
  right: 8rpx;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 14rpx 18rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  overflow: hidden;
  z-index: 2;
}
.theme-ink .tl-block {
  border: 2rpx solid var(--card-line);
  border-radius: 16rpx 8rpx 18rpx 6rpx / 8rpx 18rpx 6rpx 16rpx;
  box-shadow: 4rpx 5rpx 0 rgba(33, 30, 25, .06);
}
.theme-pebble .tl-block { border-radius: 26rpx; }
.tl-block.done { opacity: .5; }
.tl-block.done .tl-b-t { text-decoration: line-through; }

.tl-bar {
  width: 8rpx;
  border-radius: 99rpx;
  align-self: stretch;
  flex: none;
}
.tl-b-main { flex: 1; min-width: 0; }
.tl-b-t { font-size: 28rpx; line-height: 1.4; }
.tl-b-s { font-size: 22rpx; color: var(--text-3); margin-top: 6rpx; }
.tl-b-ck { font-size: 24rpx; color: var(--accent); }

.tl-fab {
  margin: 20rpx 0 8rpx;
  height: 84rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--on-accent);
  background: var(--accent);
}
.theme-pebble .tl-fab { border-radius: 99rpx; background: linear-gradient(120deg, var(--accent), var(--accent-2)); }
