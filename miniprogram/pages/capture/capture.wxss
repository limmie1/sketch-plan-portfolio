.cp-card { padding-bottom: 20rpx; }
.cp-ta {
  width: 100%;
  min-height: 140rpx;
  font-size: 29rpx;
  line-height: 1.7;
  color: var(--text);
}
.ph { color: var(--text-3); }

.cp-samples {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 16rpx;
  border-top: 1rpx solid var(--line-2);
  padding-top: 16rpx;
}
.cp-chip {
  font-size: 24rpx;
  color: var(--text-2);
  background: var(--surface-2);
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  line-height: 1.5;
}

.cp-t {
  font-size: 32rpx;
  line-height: 1.45;
  margin-bottom: 14rpx;
}
.cp-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: var(--text-2);
  margin-bottom: 10rpx;
}
.cp-warn { color: var(--accent); }
.cp-save { margin-top: 26rpx; }
