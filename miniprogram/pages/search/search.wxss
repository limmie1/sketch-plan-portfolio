.sr-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 88rpx;
  padding: 0 22rpx;
  margin-top: 20rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
}
.theme-ink .sr-bar { border: 2rpx solid var(--card-line); border-radius: 16rpx 8rpx 18rpx 6rpx; }
.theme-pebble .sr-bar { border-radius: 99rpx; }
.sr-ico { font-size: 30rpx; color: var(--text-3); }
.sr-input { flex: 1; font-size: 28rpx; color: var(--text); }
.sr-clear { font-size: 24rpx; color: var(--accent); padding: 8rpx; }
.ph { color: var(--text-3); }

.sr-hint {
  font-size: 24rpx;
  color: var(--text-3);
  margin: 22rpx 4rpx 14rpx;
}

.sr-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  margin-bottom: 14rpx;
}
.theme-ink .sr-item { border: 2rpx solid var(--card-line); border-radius: 16rpx 8rpx 18rpx 6rpx; box-shadow: 4rpx 5rpx 0 rgba(33,30,25,.06); }
.theme-pebble .sr-item { border-radius: 28rpx; }
.sr-main { flex: 1; min-width: 0; }
.sr-t { font-size: 28rpx; }
.sr-s { font-size: 22rpx; color: var(--text-3); margin-top: 8rpx; }
.sr-tag {
  font-size: 20rpx;
  color: var(--text-3);
  border: 1rpx solid var(--line);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  flex: none;
}
