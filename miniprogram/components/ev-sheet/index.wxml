<view wx:if="{{show}}" class="mask" bindtap="cancel" catchtouchmove="noop"></view>

<view wx:if="{{show}}" class="sheet" catchtap="noop" catchtouchmove="noop">
  <view class="sheet-t">{{editing ? '改一下这件事' : '记一件事'}}</view>

  <view class="field">
    <view class="field-k">做什么</view>
    <input
      class="input"
      value="{{form.title}}"
      placeholder="例如：英语阅读 · 3 篇"
      placeholder-class="ph"
      maxlength="60"
      focus="{{show && !editing}}"
      bindinput="onTitle"
    />
  </view>

  <view class="pick-row">
    <view class="field">
      <view class="field-k">日期</view>
      <picker mode="date" value="{{form.date}}" bindchange="onDate">
        <view class="input">{{form.date || '选择日期'}}</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-k">开始时间</view>
      <picker mode="time" value="{{form.start}}" bindchange="onTime">
        <view class="input">{{form.start}}</view>
      </picker>
    </view>
  </view>

  <view class="pick-row">
    <view class="field">
      <view class="field-k">大概多久</view>
      <picker range="{{durList}}" value="{{durIndex}}" bindchange="onDur">
        <view class="input">{{durList[durIndex]}} 分钟</view>
      </picker>
    </view>
    <view class="field">
      <view class="field-k">归到哪一类</view>
      <picker range="{{cats}}" range-key="name" value="{{catIndex}}" bindchange="onCat">
        <view class="input">{{cats[catIndex].name}}</view>
      </picker>
    </view>
  </view>

  <view class="sheet-a">
    <view class="btn ghost" bindtap="cancel">取消</view>
    <view class="btn primary" bindtap="submit">{{editing ? '保存修改' : '记下来'}}</view>
  </view>

  <view wx:if="{{editing}}" class="sheet-a">
    <view class="btn ghost danger" bindtap="remove">删除这件事</view>
  </view>
</view>
