# ---------- 上线需要改的 ----------
DOMAIN=sketch.example.com          # 域名；只在本机测试可写 localhost
TZ=Asia/Shanghai

# ---------- 其它 ----------
PORT=4310
DATA_DIR=./data
NODE_ENV=development               # 生产改成 production
COOKIE_SECURE=0                    # https 生产环境必须改成 1，否则浏览器会丢弃登录 Cookie

# 说明：v1.7.0 起不再有邮件服务（自助注册 / 邮件提醒 / 邮箱改密都已下线）。
#      账号用 `node server/users.mjs add <用户名>` 在服务器上手动创建。
